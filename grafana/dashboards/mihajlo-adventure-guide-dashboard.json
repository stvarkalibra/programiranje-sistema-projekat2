          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CONCAT(g.first_name, ' ', g.last_name) AS guide, COUNT(a.id) AS adventure_count, ROUND(COALESCE(SUM(a.base_price), 0), 2) AS total_base_price FROM guide_profile g LEFT JOIN adventure a ON a.guide_id = g.id GROUP BY g.id, g.first_name, g.last_name ORDER BY adventure_count DESC, total_base_price DESC LIMIT 10",
          "refId": "A"
        }
      ],
