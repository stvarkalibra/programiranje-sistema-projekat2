                      "kind": "DataQuery",
                      "group": "mysql",
                      "version": "v0",
                      "spec": {
                        "dataset": "eco_tourism_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT mt.task_name AS 'Tip zadatka', mt.estimated_duration_hours AS 'Trajanje (h)', COUNT(wo.id) AS 'Broj naloga' FROM maintenance_tasks mt LEFT JOIN work_orders wo ON mt.id = wo.task_id GROUP BY mt.id, mt.task_name, mt.estimated_duration_hours ORDER BY mt.estimated_duration_hours DESC"
                      },
                      "labels": { "grafana.app/export-label": "mysql-accommodation-1" }
