      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Opterećenje radnika – aktivni nalozi po specijalnosti",
          "description": "Broj PENDING + IN_PROGRESS naloga grupisanih po specijalnosti radnika",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "mysql",
                      "version": "v0",
                      "spec": {
                        "dataset": "eco_tourism_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT w.specialty AS 'Specijalnost', COUNT(wo.id) AS 'Aktivni nalozi', SUM(mt.estimated_duration_hours) AS 'Ukupno sati' FROM work_orders wo JOIN workers w ON wo.worker_id = w.id JOIN maintenance_tasks mt ON wo.task_id = mt.id WHERE wo.status IN ('PENDING', 'IN_PROGRESS') GROUP BY w.specialty ORDER BY COUNT(wo.id) DESC"
                      },
                      "labels": { "grafana.app/export-label": "mysql-accommodation-1" }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "bargauge",
            "version": "13.0.1+security-01",
            "spec": {
              "options": {
                "displayMode": "gradient",
                "orientation": "horizontal",
                "namePlacement": "auto",
                "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false, "calcs": [] },
                "tooltip": { "mode": "single", "sort": "none", "hideZeros": false },
                "reduceOptions": { "calcs": [], "fields": "/^Aktivni nalozi$/", "values": true },
                "showUnfilled": true,
                "sizing": "auto",
                "maxVizHeight": 300,
                "minVizHeight": 16,
                "minVizWidth": 8,
                "valueMode": "color"
              },
              "fieldConfig": {
                "defaults": {
                  "color": { "mode": "continuous-GrYlRd" },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      { "value": 0, "color": "green" },
                      { "value": 3, "color": "yellow" },
                      { "value": 5, "color": "red" }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },

      "panel-3": {
