      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Radni nalozi po statusu",
          "description": "Raspodela radnih naloga: PENDING, IN_PROGRESS, COMPLETED, CANCELLED",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "mysql",
                      "version": "v0",
                      "spec": {
                        "dataset": "eco_tourism_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT status AS 'Status', COUNT(*) AS 'Broj naloga' FROM work_orders GROUP BY status ORDER BY FIELD(status, 'PENDING', 'IN_PROGRESS', 'COMPLETED', 'CANCELLED')"
                      },
                      "labels": { "grafana.app/export-label": "mysql-accommodation-1" }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "piechart",
            "version": "13.0.1+security-01",
            "spec": {
              "options": {
                "displayLabels": ["name", "percent"],
                "pieType": "donut",
                "legend": { "displayMode": "list", "placement": "right", "showLegend": true },
                "tooltip": { "mode": "single", "sort": "none", "hideZeros": false },
                "sort": "desc",
                "reduceOptions": { "calcs": [], "fields": "", "values": true }
              },
              "fieldConfig": {
                "defaults": {
                  "color": { "mode": "palette-classic" },
                  "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } }
