        "spec": {
          "id": 3,
          "title": "Najzahtjevniji tipovi zadataka (po prosječnom trajanju)",
          "description": "Prosječno trajanje po tipu zadatka — pomaže planiranju rasporeda radnika",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
