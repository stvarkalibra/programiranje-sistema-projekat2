      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Broj smještajnih jedinica po tipu",
          "description": "Raspodela tipova smještaja (TENT, CABIN, GLAMPING, TREEHOUSE, ECO_LODGE)",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "mysql",
                      "version": "v0",
                      "spec": {
                        "dataset": "eco_tourism_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT unit_type AS 'Tip smještaja', COUNT(*) AS 'Broj jedinica' FROM units GROUP BY unit_type ORDER BY COUNT(*) DESC"
                      },
                      "labels": { "grafana.app/export-label": "mysql-accommodation-1" }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
