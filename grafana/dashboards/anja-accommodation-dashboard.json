      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Prosječna cijena po noćenju po tipu smještaja",
          "description": "Osnovna cijena (bez sezonskog množitelja) grupisana po tipu",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "mysql",
                      "version": "v0",
                      "spec": {
                        "dataset": "eco_tourism_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT u.unit_type AS 'Tip', ROUND(AVG(u.base_price_per_night), 2) AS 'Prosječna cijena (€)', MIN(u.base_price_per_night) AS 'Min cijena', MAX(u.base_price_per_night) AS 'Max cijena' FROM units u GROUP BY u.unit_type ORDER BY AVG(u.base_price_per_night) DESC"
                      },
                      "labels": { "grafana.app/export-label": "mysql-accommodation-1" }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "bargauge",
            "version": "13.0.1+security-01",
            "spec": {
              "options": {
                "displayMode": "gradient",
                "orientation": "horizontal",
                "namePlacement": "auto",
                "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false, "calcs": [] },
                "tooltip": { "mode": "single", "sort": "none", "hideZeros": false },
                "reduceOptions": { "calcs": [], "fields": "/^Prosje.*cijena.*€.*$/", "values": true },
                "showUnfilled": true,
                "sizing": "auto",
                "maxVizHeight": 300,
                "minVizHeight": 16,
                "minVizWidth": 8,
                "valueMode": "color"
              },
              "fieldConfig": {
                "defaults": {
                  "color": { "mode": "continuous-GrYlRd" },
                  "unit": "currencyEUR",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      { "value": 0, "color": "green" },
                      { "value": 80, "color": "yellow" },
                      { "value": 120, "color": "red" }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },

