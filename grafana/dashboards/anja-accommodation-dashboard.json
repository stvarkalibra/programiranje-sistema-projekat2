            "kind": "VizConfig",
            "group": "piechart",
            "version": "13.0.1+security-01",
            "spec": {
              "options": {
                "displayLabels": ["name", "percent"],
                "pieType": "donut",
                "legend": { "displayMode": "list", "placement": "right", "showLegend": true },
                "tooltip": { "mode": "single", "sort": "none", "hideZeros": false },
